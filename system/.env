# EXECOM's own local database. Created by the user on localhost XAMPP/MariaDB:
#   mysql -u root < database/schema.sql
DB_HOST=localhost
DB_NAME=execom_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

APP_NAME=EXECOM
APP_FULL_NAME=EXECOM Computer Sales & Services

# Local development only. 1 puts PHP errors and database connection details
# back on screen — leave this blank/0 on any deployed instance.
APP_DEBUG=0

# Optional. Fixed public base URL. Left blank, it's derived from whichever
# host the request came in on.
APP_URL=
